{
  "defaultProjectTrust": "always",
  "theme": "system",
  "tuiMode": "fullscreen",
  "compaction": {
    "enabled": true
  },
  "retry": {
    "baseDelayMs": 5000,
    "maxRetries": 5
  },
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.2-sol",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "openai/gpt-6.1-sol": "high",
    "openai/gpt-6.2-sol": "high",
    "openai/gpt-6-astra": "xhigh",
    "openai/gpt-6.2-astra": "xhigh",
    "google-vertex/gemini-4-argon": "high",
    "google-vertex/gemini-4-hydrogen": "xhigh",
    "google-vertex/gemini-4-neon": "xhigh",
    "opencode-go/deepseek-v4.1-flash": "high"
  },
  "enabledModels": [
    "openai/gpt-6.2-sol:high",
    "openai/gpt-6.2-astra:xhigh",
    "claude-bridge/claude-opus-5-5:xhigh",
    "google-vertex/gemini-4-neon:xhigh",
    "opencode-go/deepseek-v4.1-flash:high"
  ],
  "hideThinkingBlock": true,
  "branchSummary": {
    "skipPrompt": true
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@reedchan/statusline@1.11.3",
    "npm:pi-docparser@4.0.0",
    "npm:pi-claude-bridge@0.13.1",
    "git:github.com/dingdinglz/pi-gpt-fast-extension@0f635deed0e1d6af277104b73c1c648e25458161"
  ]
}

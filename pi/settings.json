{
  "defaultProjectTrust": "always",
  "theme": "system",
  "tuiMode": "fullscreen",
  "compaction": {
    "enabled": true
  },
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "openai/gpt-6.1-sol": "high",
    "openai/gpt-6-astra": "xhigh",
    "google-vertex/gemini-3.8-flash": "medium",
    "opencode-go/deepseek-v4.1-flash": "high"
  },
  "enabledModels": [
    "openai/gpt-6.1-sol:high",
    "openai/gpt-6-astra:xhigh",
    "google-vertex/gemini-3.8-flash:medium",
    "opencode-go/deepseek-v4.1-flash:high"
  ],
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-web-access",
    "npm:@reedchan/statusline@1.11.3",
    "npm:pi-docparser@4.0.0",
    "git:github.com/dingdinglz/pi-gpt-fast-extension"
  ]
}
